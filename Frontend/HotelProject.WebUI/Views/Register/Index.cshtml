@model CreateNewUserDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html class="h-100" lang="tr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Rosella | Kullanıcı Kayıt Formu</title>
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/adminweb/assets/images/favicon.png">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css" integrity="sha384-B4dIYHKNBt8Bc12p+WXckhzcICo0wtJAoU8YZTY5qE0Id1GSseTk6S+L3BlXeVIU" crossorigin="anonymous">
    <link href="~/adminweb/css/style.css" rel="stylesheet">
</head>

<body class="h-100">

    <!--*******************
        Preloader start
    ********************-->
    <div id="preloader">
        <div class="loader">
            <svg class="circular" viewBox="25 25 50 50">
                <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3" stroke-miterlimit="10" />
            </svg>
        </div>
    </div>
    <!--*******************
        Preloader end
    ********************-->

    <div class="login-form-bg h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-xl-6 col-lg-7 col-md-10">
                    <div class="form-input-content">
                        <div class="card login-form mb-0 shadow-sm border-0">
                            <div class="card-body pt-5 pb-5 px-5">

                                <!-- Logo / Başlık -->
                                <div class="text-center mb-4">
                                    <a href="/Default/Index/">
                                        <h2 class="font-weight-bold text-primary">Core Hotel Projesi Kayıt Formu</h2>
                                    </a>
                                    <p class="text-muted">Yeni bir hesap oluşturun</p>
                                </div>

                                <!-- Kayıt Formu -->
                                <form method="post" class="mt-4 mb-4 login-input">

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">Adınız </label>
                                        <input asp-for="Name" type="text" class="form-control" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">Soyadınız</label>
                                        <input asp-for="Surname" type="text" class="form-control" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">Kullanıcı Adı</label>
                                        <input asp-for="UserName" type="text" class="form-control" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">E-Posta Adresi</label>
                                        <input asp-for="Mail" type="email" class="form-control"required>
                                    </div>

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">Şifre</label>
                                        <input asp-for="Password" type="password" class="form-control" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="text-dark font-weight-medium">Şifrenizi Onaylayın</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" required>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg submit w-100 mt-3 shadow-sm">Kayıt Ol</button>
                                </form>

                                <!-- Giriş sayfasına yönlendirme -->
                                <div class="text-center mt-4">
                                    <p class="text-muted">Zaten bir hesabınız var mı? <a href="/Login/Index/" class="text-primary font-weight-bold">Giriş Yap</a></p>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--**********************************
        Scripts
    ***********************************-->
    <script src="~/adminweb/plugins/common/common.min.js"></script>
    <script src="~/adminweb/js/custom.min.js"></script>
    <script src="~/adminweb/js/settings.js"></script>
    <script src="~/adminweb/js/gleek.js"></script>
    <script src="~/adminweb/js/styleSwitcher.js"></script>
</body>
</html>