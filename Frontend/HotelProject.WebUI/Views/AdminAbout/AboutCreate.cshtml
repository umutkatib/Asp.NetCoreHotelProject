@model CreateAboutDto

@{
    ViewData["Title"] = "Yeni Hakkımızda Kaydı";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Yeni Hakkımızda Kaydı</h4>
                        <a asp-controller="AdminAbout" asp-action="Index" class="btn btn-light btn-sm rounded">
                            <i class="fa fa-arrow-left mr-1"></i> Listeye Dön
                        </a>
                    </div>

                    <div class="basic-form">
                        <form method="post" asp-controller="AdminAbout" asp-action="AboutCreate">
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label asp-for="AboutTitle1">Başlık 1</label>
                                    <input asp-for="AboutTitle1" class="form-control" placeholder="Başlık 1">
                                    <span asp-validation-for="AboutTitle1" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="AboutTitle2">Başlık 2</label>
                                    <input asp-for="AboutTitle2" class="form-control" placeholder="Başlık 2">
                                    <span asp-validation-for="AboutTitle2" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="AboutContent">İçerik</label>
                                <textarea asp-for="AboutContent" class="form-control" rows="5" placeholder="İçerik"></textarea>
                                <span asp-validation-for="AboutContent" class="text-danger"></span>
                            </div>                           
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save mr-1"></i> Kaydet
                            </button>
                            <a asp-controller="AdminAbout" asp-action="Index" class="btn btn-light">Vazgeç</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>