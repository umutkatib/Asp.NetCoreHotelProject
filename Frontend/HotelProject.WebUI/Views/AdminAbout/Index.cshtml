@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımızda Listesi";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Hakkımızda Listesi</h4>

                        <!-- Eğer liste boşsa VEYA hiç kayıt yoksa 'Yeni Kayıt Ekle' butonunu göster -->
                        @if (Model == null || !Model.Any())
                        {
                            <a asp-controller="AdminAbout" asp-action="AboutCreate" class="btn btn-primary btn-sm rounded">
                                <i class="fa fa-plus mr-1"></i> Yeni Kayıt Ekle
                            </a>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered zero-configuration">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Başlık</th>
                                    <th>İçerik</th>
                                    <th class="text-center" style="width: 90px;">Oda</th>
                                    <th class="text-center" style="width: 90px;">Personel</th>
                                    <th class="text-center" style="width: 90px;">Müşteri</th>
                                    <th class="text-center" style="width: 140px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <th>@item.AboutID</th>
                                            <td>
                                                <span class="font-weight-bold">@item.AboutTitle1</span><br />
                                                <small class="text-muted">@item.AboutTitle2</small>
                                            </td>
                                            <td>@(item.AboutContent?.Length > 80 ? item.AboutContent.Substring(0, 80) + "..." : item.AboutContent)</td>
                                            <td class="text-center">
                                                <span class="badge badge-primary font-weight-normal px-2 py-1">@item.AboutRoomCount</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-info font-weight-normal px-2 py-1">@item.AboutStaffCount</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-success font-weight-normal px-2 py-1">@item.AboutCustomerCount</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="text-nowrap">
                                                    <a asp-controller="AdminAbout" asp-action="AboutUpdate" asp-route-id="@item.AboutID" class="mr-2" data-toggle="tooltip" data-placement="top" title="Güncelle">
                                                        <i class="fa fa-pencil fa-lg text-warning"></i>
                                                    </a>
                                                    <a asp-controller="AdminAbout" asp-action="AboutDelete" asp-route-id="@item.AboutID"
                                                       onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');"
                                                       data-toggle="tooltip" data-placement="top" title="Sil">
                                                        <i class="fa fa-trash fa-lg text-danger"></i>
                                                    </a>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="fa fa-info-circle mr-1"></i> Henüz kayıtlı bir hakkımızda içeriği bulunamadı.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>