@model UpdateAboutDto

@{
    ViewData["Title"] = "Hakkımızda Güncelle";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="content-body">
    <div class="container-fluid">
        <div class="row page-titles mx-0 mb-3">
            <div class="col p-md-0">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Yönetim</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminAbout" asp-action="Index">Hakkımızda</a></li>
                    <li class="breadcrumb-item active"><a href="javascript:void(0)">Güncelle</a></li>
                </ol>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Hakkımızda Kaydını Güncelle</h4>
                        <div class="basic-form">
                            <form method="post" asp-controller="AdminAbout" asp-action="AboutUpdate">
                                <input type="hidden" asp-for="AboutID" />

                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label asp-for="AboutTitle1">Başlık 1</label>
                                        <input asp-for="AboutTitle1" class="form-control" placeholder="Başlık 1">
                                        <span asp-validation-for="AboutTitle1" class="text-danger small"></span>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label asp-for="AboutTitle2">Başlık 2</label>
                                        <input asp-for="AboutTitle2" class="form-control" placeholder="Başlık 2">
                                        <span asp-validation-for="AboutTitle2" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="AboutContent">İçerik</label>
                                    <textarea asp-for="AboutContent" class="form-control" rows="5" placeholder="İçerik"></textarea>
                                    <span asp-validation-for="AboutContent" class="text-danger small"></span>
                                </div>

                                <div class="form-group mt-3">
                                    <button type="submit" class="btn btn-success px-4 text-white">Güncelle</button>
                                    <a asp-controller="AdminAbout" asp-action="Index" class="btn btn-light px-4 ml-2">Vazgeç</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>