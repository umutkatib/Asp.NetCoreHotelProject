@model List<ResultServiceDto>

<div class="col-md-6">
    <h6 class="section-title text-start text-primary text-uppercase mb-4">Hizmetler</h6>
    @foreach(var item in Model)
    {
        <a class="btn btn-link" 
            asp-controller="Service" 
            asp-action="DetailService" 
            asp-route-id="@item.ServiceID">
        @item.ServiceTitle
        </a>
    }
</div>