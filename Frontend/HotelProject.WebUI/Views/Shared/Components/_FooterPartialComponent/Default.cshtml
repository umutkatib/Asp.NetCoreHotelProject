@model List<ResultContactDto>

<div class="container-fluid bg-dark text-light footer wow fadeIn" data-wow-delay="0.1s">
    <div class="container pb-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <div class="bg-primary rounded p-4">
                    <a asp-controller="Default" asp-action="Index"><h1 class="text-white text-uppercase mb-3">UmutKatib¨</h1></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <h6 class="section-title text-start text-primary text-uppercase mb-4">İletişim</h6>
                @foreach(var item in Model)
                {
                    <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>@item.ContactAddress, @item.ContactDistrict, @item.ContactCity, @item.ContactCountry</p>
                    <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>@item.ContactPhone</p>
                    <p class="mb-2"><i class="fa fa-envelope me-3"></i>@item.ContactMail</p>
                }

                @await Component.InvokeAsync("_FooterSocialMediaPartialComponent")

                
            </div>
            <div class="col-lg-5 col-md-12">
                <div class="row gy-5 g-4">
                    <div class="col-md-6">
                        <h6 class="section-title text-start text-primary text-uppercase mb-4">Katib INC</h6>

                        <a class="btn btn-link" asp-controller="About" asp-action="Index">
                            Hakkımızda
                         </a>
                        <a class="btn btn-link" asp-controller="Contact" asp-action="Index">
                            İletişim
                        </a>
                        <a class="btn btn-link" asp-controller="Privacy" asp-action="Index">Gizlilik Politikası
                        </a>
                        <a class="btn btn-link" asp-controller="Conditions" asp-action="Index">
                            Şartlar ve Koşullar
                        </a>
                        <a class="btn btn-link" asp-controller="Help" asp-action="Index">
                            Destek
                        </a>
                    </div>

                    @await Component.InvokeAsync("_FooterServicePartialComponent")
                    
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="copyright">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; <a class="border-bottom" href="https://github.com/umutkatib" target="_blank" rel="noopener noreferrer">UmutKatib - @DateTime.Now.Year</a>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="footer-menu">
                        <a asp-controller="Default" asp-action="Index">Ana Sayfa</a>
                        <a asp-controller="Cookies" asp-action="Index">Çerezler</a>
                        <a asp-controller="Help" asp-action="Index">Yardım</a>
                        <a asp-controller="SSS" asp-action="Index">SSS</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>