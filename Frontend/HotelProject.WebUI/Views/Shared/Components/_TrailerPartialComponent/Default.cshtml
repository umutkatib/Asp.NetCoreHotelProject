@model List<ResultTrailerDto>

@foreach (var item in Model)
{
    <div class="container-fluid py-5 px-0 wow zoomIn" data-wow-delay="0.1s">
        <div class="row g-0">
            <div class="col-md-6 bg-dark d-flex align-items-center">
                <div class="p-5">
                    <h6 class="section-title text-start text-white text-uppercase mb-3">@item.TrailerTitle</h6>
                    <h1 class="text-white mb-4">@item.TrailerSubTitle</h1>
                    <p class="text-white mb-4">@item.TrailerDescription</p>
                    <a href="" class="btn btn-primary py-md-3 px-md-5 me-3">Odalarımız</a>
                    <a href="" class="btn btn-light py-md-3 px-md-5">Oda Ayırt</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="ratio ratio-16x9 h-100">
                    <iframe src="@item.TrailerVideoFrame" title="YouTube video oynatıcı" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
}