@model List<ResultServiceDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Hizmet İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Hizmet Listesi</div>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">İkon</th>
                                    <th scope="col">Hizmet Başlığı</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th>@count</th>
                                            <td>
                                                <i class="@item.ServiceIcon" style="font-size: 20px;"></i>
                                            </td>
                                            <td>@item.ServiceTitle</td>
                                            <td><a href="/AdminService/DeleteService/@item.ServiceID" class="btn btn-outline-danger btn-sm"><i class="fa fa-trash"></i> Sil</a></td>
                                            <td><a href="/AdminService/UpdateService/@item.ServiceID" class="btn btn-outline-success btn-sm"><i class="fa fa-edit"></i> Güncelle</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <a href="/AdminService/CreateService/" class="btn btn-primary"><i class="fa fa-plus"></i> Yeni Hizmet Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>