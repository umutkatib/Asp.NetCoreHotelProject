@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml"; 
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referans (Testimonial) İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Referans Listesi</div>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Görsel</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">Unvan</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th>@count</th>
                                        <td>
                                            <img src="@item.TestimonialImage" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="Referans Görseli" />
                                        </td>
                                        <td>@item.TestimonialName</td>
                                        <td>@item.TestimonialTitle</td>
                                        <td><a href="/AdminTestimonial/DeleteTestimonial/@item.TestimonialID" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Sil</a></td>
                                        <td><a href="/AdminTestimonial/UpdateTestimonial/@item.TestimonialID" class="btn btn-success btn-sm"><i class="fa fa-edit"></i> Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/AdminTestimonial/CreateTestimonial/" class="btn btn-primary btn-rounded"><i class="fa fa-plus"></i> Yeni Referans Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>