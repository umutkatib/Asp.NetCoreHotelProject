@model List<ResultStaffDto>

@{
    ViewData["Title"] = "Personel Listesi";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Personel Listesi</h4>
                        <a href="/AdminStaff/CreateStaff/" class="btn btn-primary btn-sm rounded">
                            <i class="fa fa-plus mr-1"></i> Yeni Personel Ekle
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered zero-configuration">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Ad Soyad</th>
                                    <th>Unvan</th>
                                    <th class="text-center" style="width: 180px;">Sosyal Medya</th>
                                    <th class="text-center" style="width: 200px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <th>@item.StaffID</th>
                                            <td>
                                                <span class="font-weight-bold">@item.StaffName</span>
                                            </td>
                                            <td>
                                                <span class="badge badge-primary font-weight-normal px-2 py-1">@item.StaffTitle</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    @if (!string.IsNullOrEmpty(item.StaffSocialMediaForF))
                                                    {
                                                        <a href="@item.StaffSocialMediaForF" target="_blank" class="btn btn-sm btn-outline-facebook px-2" title="Facebook">
                                                            <i class="fa fa-facebook"></i>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.StaffSocialMediaForT))
                                                    {
                                                        <a href="@item.StaffSocialMediaForT" target="_blank" class="btn btn-sm btn-outline-twitter px-2" title="Twitter / X">
                                                            <i class="fa fa-twitter"></i>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.StaffSocialMediaForI))
                                                    {
                                                        <a href="@item.StaffSocialMediaForI" target="_blank" class="btn btn-sm btn-outline-instagram px-2" title="Instagram">
                                                            <i class="fa fa-instagram"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="text-nowrap">
                                                    <a href="/AdminStaff/GetStaff/@item.StaffID" class="mr-2" data-toggle="tooltip" data-placement="top" title="Detaylar">
                                                        <i class="fa fa-eye fa-lg text-info"></i>
                                                    </a>
                                                    <a href="/AdminStaff/UpdateStaff/@item.StaffID" class="mr-2" data-toggle="tooltip" data-placement="top" title="Güncelle">
                                                        <i class="fa fa-pencil fa-lg text-warning"></i>
                                                    </a>
                                                    <a href="/AdminStaff/DeleteStaff/@item.StaffID"
                                                       data-toggle="tooltip" data-placement="top" title="Sil">
                                                        <i class="fa fa-trash fa-lg text-danger"></i>
                                                    </a>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fa fa-info-circle mr-1"></i> Henüz kayıtlı bir personel bulunamadı.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

    </script>
}