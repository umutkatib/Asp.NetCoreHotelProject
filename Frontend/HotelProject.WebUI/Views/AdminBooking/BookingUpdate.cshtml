@model UpdateBookingDto

@{
    ViewData["Title"] = "UpdateBooking";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="breadcrumb-text">
            <h4>Rezervasyon Güncelle</h4>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Booking/Index">Rezervasyonlar</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Güncelle</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Rezervasyon Düzenle (ID: @Model.BookingID)</h4>
                <form action="/Booking/Update" method="post">

                    <!-- Gizli ID alanı -->
                    <input type="hidden" name="BookingID" value="@Model.BookingID" />

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Ad</label>
                            <input type="text" class="form-control" name="BookingName" value="@Model.BookingName">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Soyad</label>
                            <input type="text" class="form-control" name="BookingSurname" value="@Model.BookingSurname">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>E-Mail Adresi</label>
                            <input type="email" class="form-control" name="BookingMail" value="@Model.BookingMail">
                        </div>
                        <div class="form-group col-md-3">
                            <label>Giriş Tarihi (Check-in)</label>
                            <input type="date" class="form-control" name="BookingCheckin" value="@Model.BookingCheckin.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group col-md-3">
                            <label>Çıkış Tarihi (Check-out)</label>
                            <input type="date" class="form-control" name="BookingCheckout" value="@Model.BookingCheckout.ToString("yyyy-MM-dd")">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Yetişkin Sayısı</label>
                            <input type="number" class="form-control" name="BookingAdultCount" value="@Model.BookingAdultCount" min="1">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Çocuk Sayısı</label>
                            <input type="number" class="form-control" name="BookingChildCount" value="@Model.BookingChildCount" min="0">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Oda Sayısı</label>
                            <input type="number" class="form-control" name="BookingRoomCount" value="@Model.BookingRoomCount" min="1">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Özel İstek</label>
                            <input type="text" class="form-control" name="BookingSpecialRequest" value="@Model.BookingSpecialRequest">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Açıklama(Sadece İşletme Tarafında Görülebilir)</label>
                            <input type="text" class="form-control" name="BookingSpecialDescription" value="@Model.BookingSpecialDescription">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="BookingStatus" id="BookingStatus" value="true" @(Model.BookingStatus ? "checked" : "")>
                            <label class="form-check-label" for="BookingStatus">
                                Rezervasyon Aktif / Onaylı
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-rounded">Değişiklikleri Kaydet</button>
                    <a href="/AdminBooking/Index" class="btn btn-light btn-rounded ml-2">Geri Dön</a>
                </form>
            </div>
        </div>
    </div>
</div>
