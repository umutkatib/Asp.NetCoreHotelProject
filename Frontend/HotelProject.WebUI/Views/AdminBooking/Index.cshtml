@model List<ResultBookingDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="breadcrumb-text">
            <h4>Rezervasyon Listesi</h4>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Anasayfa</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Rezervasyonlar</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title">Rezervasyon Yönetimi</h4>
                    <a href="/AdminBooking/BookingCreate" class="btn btn-primary btn-rounded"><i class="fa fa-plus"></i> Yeni Rezervasyon Ekle</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered zero-configuration">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Ad Soyad</th>
                                <th>E-Mail</th>
                                <th>Giriş - Çıkış</th>
                                <th>Kişi / Oda</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.BookingID</strong></td>
                                    <td>@item.BookingName @item.BookingSurname</td>
                                    <td>@item.BookingMail</td>
                                    <td>@item.BookingCheckin.ToString("dd.MM.yyyy") - @item.BookingCheckout.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge badge-light">
                                            @item.BookingAdultCount Yetişkin, @item.BookingChildCount Çocuk
                                        </span> / @item.BookingRoomCount Oda
                                    </td>
                                    <td>
                                        <span class="badge @(item.BookingStatus ? "badge-success" : "badge-danger") px-2">
                                            @(item.BookingStatus ? "Onaylandı" : "İptal / Beklemede")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="/AdminBooking/BookingStatusChange/@item.BookingID"
                                               data-toggle="tooltip"
                                               data-placement="top"
                                               title="@(item.BookingStatus ? "İptal Et" : "Onayla")"
                                               class="btn btn-sm @(item.BookingStatus ? "btn-outline-warning" : "btn-outline-success") mr-1">
                                                <i class="fa @(item.BookingStatus ? "fa-ban" : "fa-check")"></i>
                                            </a>

                                            <a href="/AdminBooking/BookingUpdate/@item.BookingID" data-toggle="tooltip" data-placement="top" title="Güncelle" class="btn btn-sm btn-outline-primary mr-1"><i class="fa fa-pencil"></i></a>
                                            <a href="/AdminBooking/BookingDelete/@item.BookingID" data-toggle="tooltip" data-placement="top" title="Sil" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>