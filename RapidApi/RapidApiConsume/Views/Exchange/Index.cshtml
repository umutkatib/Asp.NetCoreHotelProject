@model ExchangeViewModel

@{
    Layout = null;
    var currencies = Model.rates.Values.SelectMany(x => x.Keys).Distinct().ToList();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Döviz Kurları</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <h2 class="mb-1">Döviz Kurları</h2>
        <p class="text-muted">Baz: @Model.BaseCurrency | @Model.StartDate - @Model.EndDate</p>

        <div class="card shadow-sm">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih</th>
                        @foreach (var c in currencies)
                        {
                            <th class="text-end">@c</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in Model.rates.OrderBy(x => x.Key))
                    {
                        <tr>
                            <td>@day.Key</td>
                            @foreach (var c in currencies)
                            {
                                <td class="text-end">
                                    @(day.Value.ContainsKey(c) ? day.Value[c].ToString("0.000000") : "-")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>